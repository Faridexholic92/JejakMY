# ---------------------------------------------------------------------------
# Jejak - contoh konfigurasi. Salin ke .env dan isi apa yang kau ada.
# Tanpa satu pun kunci di bawah, aplikasi tetap jalan dalam mod demo.
# ---------------------------------------------------------------------------

PORT=4000
HOST=127.0.0.1
DB_PATH=./data/jejak.db

# --- Poller ----------------------------------------------------------------
POLLER_ENABLED=true
POLLER_TICK_MS=10000
POLLER_BATCH=20
POLLER_MAX_ATTEMPTS=8
# Had atas selang poll dalam minit (demo pantas: 0.05)
POLLER_MAX_INTERVAL_MIN=720

# --- Mod demo (kurier tiruan tempatan) --------------------------------------
# Jalankan `npm run courier:fake` dalam terminal berasingan.
DEMO_MODE=true
DEMO_COURIER_URL=http://127.0.0.1:4010
FAKE_COURIER_PORT=4010
# Berapa milisaat mewakili satu langkah perjalanan parcel demo.
FAKE_COURIER_STEP_MS=4000

# --- Agregator (TrackingMore / AfterShip / Tracking.my) ---------------------
# Isi ini dan adapter agregator akan mengambil alih daripada mod demo.
# AGGREGATOR_API_KEY=
# AGGREGATOR_BASE_URL=https://api.trackingmore.com
# AGGREGATOR_KEY_HEADER=Tracking-Api-Key

# --- Ninja Van (API rasmi) --------------------------------------------------
# NINJAVAN_CLIENT_ID=
# NINJAVAN_CLIENT_SECRET=
# NINJAVAN_BASE_URL=https://api.ninjavan.co
# NINJAVAN_COUNTRY=my
# Sahkan laluan sebenar dengan api-docs.ninjavan.co sebelum guna di produksi.
# NINJAVAN_TRACK_PATH=/{country}/1.0/orders/{trackingNumber}/events

# --- Webhook masuk ----------------------------------------------------------
WEBHOOK_SECRET=tukar-rahsia-ini
WEBHOOK_SIGNATURE_HEADER=x-jejak-signature
WEBHOOK_REQUIRE_SIGNATURE=true

# --- Notifikasi -------------------------------------------------------------
NOTIFY_STATUSES=OUT_FOR_DELIVERY,FAILED_ATTEMPT,EXCEPTION,DELIVERED,RETURNED
# Webhook keluar untuk seller sambung ke sistem mereka sendiri.
# NOTIFY_WEBHOOK_URL=
# WhatsApp Cloud API (perlu akaun WhatsApp Business yang diluluskan).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_API_VERSION=v21.0

# --- HTTP -------------------------------------------------------------------
HTTP_TIMEOUT_MS=12000
HTTP_RETRIES=2
